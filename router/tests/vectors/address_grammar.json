   "in": "alice@example.com",
   "out": "alice@example.com",
   "why": "plain"
  },
  {
   "in": "Alice@Example.COM",
   "out": "Alice@example.com",
   "why": "upper case: the domain folds, the local part is kept exactly"
  },
  {
   "in": "a.b+c@x-y.example",
   "out": "a.b+c@x-y.example",
   "why": "dot-atom local part, hyphenated label"
  },
  {
   "in": "agent.bob@local",
   "out": "agent.bob@local",
   "why": "the legacy single-label domain"
  },
